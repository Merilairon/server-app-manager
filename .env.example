# Tenant namespace prefix for all Docker resources (networks, volumes, backups, logs).
TENANT_ID=appforge

# Postgres connection string used by the backend.
DATABASE_URL=postgres://sam:sam@db:5432/sam

# Secret used to sign JWTs. MUST be overridden in production.
JWT_SECRET=changeme-change-this-in-production

# Allowed CORS origin for the Angular SPA.
CORS_ORIGIN=https://app.example.com

# Traefik / ACME
# Use Let's Encrypt staging by default to avoid rate limits during development.
ACME_PRODUCTION=false
# Email address for Let's Encrypt certificate notifications.
ACME_EMAIL=admin@example.com

# Compose project name (drives the tenant_<id>_ resource prefix).
COMPOSE_PROJECT_NAME=appforge

# Admin credentials for the application
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-password
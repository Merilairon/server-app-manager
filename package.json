{
  "name": "server-app-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Centralised orchestration for the Rust/axum backend and Angular frontend.",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "concurrently --names \"backend,frontend\" --prefix-colors \"blue,green\" --kill-others-on-fail \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:backend": "cargo run --release --manifest-path backend/Cargo.toml",
    "dev:frontend": "pnpm --dir frontend start",
    "dev:docker": "concurrently --names \"backend,frontend\" --prefix-colors \"blue,green\" --kill-others-on-fail \"pnpm run dev:docker:logs\" \"pnpm run dev:frontend\"",
    "dev:docker:up": "docker compose -f docker-compose.dev.yml --env-file .env.dev up -d --build",
    "dev:docker:down": "docker compose -f docker-compose.dev.yml down",
    "dev:docker:logs": "docker compose -f docker-compose.dev.yml logs -f backend frontend",
    "dev:docker:rebuild": "docker compose -f docker-compose.dev.yml up -d --build --force-recreate",
    "dev:docker:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d --build",
    "build": "concurrently --names \"backend,frontend\" --prefix-colors \"blue,green\" --kill-others-on-fail \"pnpm run build:backend\" \"pnpm run build:frontend\"",
    "build:backend": "cargo build --release --manifest-path backend/Cargo.toml",
    "build:frontend": "pnpm --dir frontend run build",
    "test": "concurrently --names \"backend,frontend\" --prefix-colors \"blue,green\" --kill-others-on-fail \"pnpm run test:backend\" \"pnpm run test:frontend\"",
    "test:backend": "cargo test --manifest-path backend/Cargo.toml",
    "test:frontend": "pnpm --dir frontend test",
    "install:all": "pnpm --dir frontend install --frozen-lockfile",
    "clean": "cargo clean --manifest-path backend/Cargo.toml && pnpm --dir frontend store prune"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  },
  "volta": {
    "node": "24.15.0"
  },
  "engines": {
    "runtime": {
      "name": "node",
      "version": "24.15.0",
      "onFail": "download"
    }
  }
}

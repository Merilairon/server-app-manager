# Development environment overrides for docker-compose.dev.yml.
# Copy to .env.dev and adjust as needed:
#   cp .env.dev.example .env.dev

# Tenant namespace prefix (dev resources get a _dev suffix).
TENANT_ID=appforge

# Main app domain; installed apps get {slug}.<BASE_DOMAIN> subdomains.
BASE_DOMAIN=app.example.com

# Publish app container ports on the host for direct access in dev.
PUBLISH_APP_PORTS=true

# Directory that contains the apps/ store/enabled/disabled folders.
COMPOSE_APPS_DIR=/data

# Postgres connection string — points to the dev db service.
DATABASE_URL=postgres://sam:sam@db:5432/sam

# Dev JWT secret (do NOT reuse in production).
JWT_SECRET=dev-only-not-for-production

# CORS origin for the Angular dev server.
CORS_ORIGIN=http://localhost:4200

# Log level for the backend (debug for dev).
RUST_LOG=debug

# Compose project name (drives the tenant_<id>_dev_ resource prefix).
COMPOSE_PROJECT_NAME=appforge

# Admin credentials for the application
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-password